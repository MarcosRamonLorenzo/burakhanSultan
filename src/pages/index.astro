---
// src/pages/index.astro
import { Image } from 'astro:assets';
import heroPhoto from '../assets/img/b1.jpeg';
import nightPhoto from '../assets/img/b2.jpeg';
import riversidePhoto from '../assets/img/b3.jpeg';
import profileVideo from '../assets/img/v1.mp4?url';
import '../styles/global.css';
---
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Burakhan | Laid-Back &amp; Open to Where Things Go</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;900&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            obsidian: '#09080A',
            'obsidian-card': 'rgba(18, 15, 20, 0.85)',
            burgundy: '#590D22',
            'burgundy-dark': '#3B0713',
            gold: '#D4AF37',
            'gold-light': '#F5E6B8',
            'gold-dark': '#A38025',
            ivory: '#F8F5F0',
          },
          fontFamily: {
            cinzel: ['Cinzel', 'serif'],
            cormorant: ['Cormorant Garamond', 'serif'],
            montserrat: ['Montserrat', 'sans-serif'],
          },
          boxShadow: {
            'gold-glow': '0 0 25px rgba(212, 175, 55, 0.25)',
            'gold-glow-lg': '0 0 45px rgba(212, 175, 55, 0.4)',
            'burgundy-glow': '0 0 30px rgba(89, 13, 34, 0.5)',
          },
        },
      },
    };
  </script>

  <style is:global>
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: #09080A; }
    ::-webkit-scrollbar-thumb { background: #3B0713; border: 1px solid #D4AF37; border-radius: 4px; }

    .gold-border-gradient { border-image: linear-gradient(135deg, #D4AF37 0%, #3B0713 50%, #F5E6B8 100%) 1; }

    .gold-text-shimmer {
      background: linear-gradient(135deg, #FFF 0%, #D4AF37 40%, #F5E6B8 70%, #A38025 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .bg-pattern {
      background-color: #09080A;
      background-image: radial-gradient(rgba(212, 175, 55, 0.08) 1px, transparent 1px), radial-gradient(rgba(89, 13, 34, 0.15) 1px, #09080A 1px);
      background-size: 40px 40px;
      background-position: 0 0, 20px 20px;
    }

    .glass-card {
      background: rgba(18, 15, 20, 0.85);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(212, 175, 55, 0.25);
    }
    .glass-card:hover {
      border-color: rgba(212, 175, 55, 0.55);
      box-shadow: 0 0 30px rgba(212, 175, 55, 0.15);
    }

    .section-divider { display: flex; align-items: center; justify-content: center; gap: 12px; }
    .section-divider::before, .section-divider::after {
      content: '';
      height: 1px;
      width: 80px;
      background: linear-gradient(90deg, transparent, #D4AF37, transparent);
    }

    /* ===== Tema modern ===== */
    body[data-theme="modern"] {
      background-color: #f8fafc;
      background-image: radial-gradient(rgba(79, 70, 229, 0.07) 1px, transparent 1px);
      color: #1f2937;
      font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    }
    body[data-theme="modern"] nav {
      background-color: rgba(255, 255, 255, 0.92);
      border-color: #cbd5e1;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    }
    body[data-theme="modern"] .glass-card {
      background: rgba(255, 255, 255, 0.92);
      border-color: #cbd5e1;
      box-shadow: 0 14px 40px rgba(15, 23, 42, 0.07);
      backdrop-filter: blur(16px);
    }
    body[data-theme="modern"] .glass-card:hover {
      border-color: #c7d2fe;
      box-shadow: 0 18px 45px rgba(79, 70, 229, 0.12);
    }
    body[data-theme="modern"] [class*="text-gold"] { color: #4338ca !important; }
    body[data-theme="modern"] [class*="text-ivory"] { color: #1f2937 !important; }
    body[data-theme="modern"] .profile-overlay [class*="text-ivory"] { color: #fff !important; }
    body[data-theme="modern"] .gallery-caption [class*="text-gold"] { color: #c4b5fd !important; }
    body[data-theme="modern"] .gallery-caption [class*="text-ivory"] { color: #f8fafc !important; }
    body[data-theme="modern"] [class*="border-gold"] { border-color: #c7d2fe !important; }
    body[data-theme="modern"] .date-radio:checked + label {
      border-color: #4338ca !important;
    }
    body[data-theme="after-dark"] .date-radio:checked + label {
      border-color: #e7a0b5 !important;
    }
    body[data-theme="modern"] input,
    body[data-theme="modern"] textarea {
      color: #1f2937 !important;
      border-color: #94a3b8 !important;
    }
    body[data-theme="modern"] input::placeholder,
    body[data-theme="modern"] textarea::placeholder { color: #64748b; opacity: 1; }
    body[data-theme="modern"] input:focus-visible,
    body[data-theme="modern"] textarea:focus-visible {
      border-color: #4338ca !important;
      box-shadow: 0 0 0 3px rgba(67, 56, 202, 0.16);
    }
    body[data-theme="modern"] [class*="bg-burgundy"],
    body[data-theme="modern"] [class*="bg-obsidian"] { background-color: #eef2f7 !important; }
    body[data-theme="modern"] .font-cinzel,
    body[data-theme="modern"] .font-cormorant {
      font-family: Inter, ui-sans-serif, system-ui, sans-serif !important;
      letter-spacing: normal;
    }
    body[data-theme="modern"] .gold-text-shimmer {
      background-image: linear-gradient(120deg, #1e1b4b 0%, #4338ca 55%, #6d28d9 100%);
    }
    body[data-theme="modern"] .bg-pattern {
      background-color: #f8fafc;
      background-image: radial-gradient(rgba(79, 70, 229, 0.07) 1px, transparent 1px);
    }
    body[data-theme="modern"] .bg-gradient-to-b {
      background-image: linear-gradient(180deg, #f8fafc 0%, #eef2ff 50%, #f8fafc 100%) !important;
    }
    body[data-theme="modern"] .section-divider::before,
    body[data-theme="modern"] .section-divider::after {
      background: linear-gradient(90deg, transparent, #a5b4fc, transparent);
    }
    body[data-theme="modern"] a[href="#apply"],
    body[data-theme="modern"] #submit-btn {
      background-image: linear-gradient(135deg, #4338ca, #312e81);
      border-color: #312e81;
      color: #fff !important;
      box-shadow: 0 10px 24px rgba(79, 70, 229, 0.22);
    }

    /* ===== Tema after-dark ===== */
    body[data-theme="after-dark"] {
      background-color: #130d15;
      background-image: radial-gradient(rgba(196, 111, 143, 0.1) 1px, transparent 1px), radial-gradient(rgba(37, 19, 34, 0.8) 1px, #130d15 1px);
      color: #f8e9ef;
    }
    body[data-theme="after-dark"] nav {
      background-color: rgba(19, 13, 21, 0.94);
      border-color: rgba(196, 111, 143, 0.3);
    }
    body[data-theme="after-dark"] .glass-card {
      background: linear-gradient(145deg, rgba(48, 28, 43, 0.92), rgba(24, 16, 27, 0.94));
      border-color: rgba(196, 111, 143, 0.34);
      box-shadow: 0 16px 45px rgba(8, 4, 10, 0.32);
    }
    body[data-theme="after-dark"] .glass-card:hover {
      border-color: rgba(231, 160, 181, 0.65);
      box-shadow: 0 0 32px rgba(196, 111, 143, 0.18);
    }
    body[data-theme="after-dark"] [class*="text-gold"] { color: #e7a0b5 !important; }
    body[data-theme="after-dark"] [class*="border-gold"] { border-color: rgba(196, 111, 143, 0.55) !important; }
    body[data-theme="after-dark"] [class*="bg-burgundy"],
    body[data-theme="after-dark"] [class*="bg-obsidian"] { background-color: #251522 !important; }
    body[data-theme="after-dark"] .gold-text-shimmer {
      background-image: linear-gradient(135deg, #fff5f7 0%, #e7a0b5 45%, #f4c8d4 75%, #a95474 100%);
    }
    body[data-theme="after-dark"] .bg-pattern {
      background-color: #130d15;
      background-image: radial-gradient(rgba(196, 111, 143, 0.1) 1px, transparent 1px), radial-gradient(rgba(37, 19, 34, 0.8) 1px, #130d15 1px);
    }
    body[data-theme="after-dark"] .section-divider::before,
    body[data-theme="after-dark"] .section-divider::after {
      background: linear-gradient(90deg, transparent, #c46f8f, transparent);
    }
    body[data-theme="after-dark"] a[href="#apply"],
    body[data-theme="after-dark"] #submit-btn {
      background-image: linear-gradient(135deg, #78374f, #351b34 55%, #78374f);
      border-color: #d58ba5;
      color: #fff0f5;
      box-shadow: 0 0 28px rgba(196, 111, 143, 0.24);
    }

    /* ===== Botón de tema ===== */
    .style-toggle {
      border: 1px solid rgba(212, 175, 55, 0.45);
      color: #f5e6b8;
      background: rgba(89, 13, 34, 0.35);
      transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
    }
    .style-toggle:hover, .style-toggle:focus-visible { border-color: #f5e6b8; outline: none; }
    body[data-theme="after-dark"] .style-toggle {
      border-color: rgba(231, 160, 181, 0.55);
      color: #ffeaf1;
      background: rgba(120, 55, 79, 0.35);
    }
    body[data-theme="after-dark"] #profile-image-frame {
      background: #251522;
      border-color: rgba(196, 111, 143, 0.55);
    }
    body[data-theme="modern"] .style-toggle {
      border-color: #dfe2f0;
      color: #4338ca;
      background: #fff;
    }
  </style>
</head>

<body data-theme="modern" class="bg-obsidian text-ivory font-montserrat antialiased bg-pattern min-h-screen selection:bg-burgundy selection:text-gold">

  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-40 bg-obsidian/90 backdrop-blur-md border-b border-gold/20 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl border border-gold/40 flex items-center justify-center bg-burgundy/40 group-hover:border-gold transition-colors">
          <span class="font-montserrat text-lg font-bold text-gold">B</span>
        </div>
        <div>
          <span class="font-cinzel text-xl sm:text-2xl font-bold tracking-widest text-gold block">BURAKHAN</span>
          <span class="font-cormorant text-xs text-gold/60 tracking-wider block -mt-1 uppercase">Easygoing. Open to where things go.</span>
        </div>
      </a>

      <div class="hidden md:flex items-center space-x-8 text-sm tracking-widest uppercase">
        <a href="#legend" class="text-ivory/80 hover:text-gold transition-colors">About</a>
        <a href="#gallery" class="text-ivory/80 hover:text-gold transition-colors">Photos</a>
        <a href="#video" class="text-ivory/80 hover:text-gold transition-colors">Video</a>
        <a href="#whispers" class="text-ivory/80 hover:text-gold transition-colors">The vibe</a>
        <a href="#apply" class="px-5 py-2.5 bg-gradient-to-r from-burgundy via-burgundy-dark to-burgundy border border-gold/50 hover:border-gold rounded-full text-gold font-cinzel font-semibold tracking-wider transition-all duration-300 shadow-gold-glow hover:scale-105">Drop a note</a>
        <button type="button" data-style-toggle class="style-toggle rounded-full px-4 py-2.5 font-cinzel text-xs font-semibold tracking-wider" aria-pressed="false" aria-label="Switch to After Dark style">
          <span data-style-icon aria-hidden="true">☾</span>
          <span data-style-label>After Dark</span>
        </button>
      </div>

      <div class="md:hidden flex items-center gap-2">
        <button type="button" data-style-toggle class="style-toggle rounded-full px-3 py-2 font-cinzel text-xs font-semibold tracking-wide" aria-pressed="false" aria-label="Switch to After Dark style">
          <span data-style-icon aria-hidden="true">☾</span>
          <span data-style-label>After Dark</span>
        </button>
        <button id="mobile-menu-btn" class="text-gold focus:outline-none p-2" aria-label="Toggle Menu">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-obsidian/95 border-b border-gold/30 px-6 py-6 space-y-4 text-center">
      <a href="#legend" class="block text-ivory uppercase tracking-widest py-2 hover:text-gold">About</a>
      <a href="#gallery" class="block text-ivory uppercase tracking-widest py-2 hover:text-gold">Photos</a>
      <a href="#video" class="block text-ivory uppercase tracking-widest py-2 hover:text-gold">Video</a>
      <a href="#whispers" class="block text-ivory uppercase tracking-widest py-2 hover:text-gold">The vibe</a>
      <a href="#apply" class="block w-full py-3 bg-burgundy border border-gold text-gold font-cinzel tracking-widest uppercase rounded-full">Drop a note</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-screen pt-28 pb-16 flex items-center justify-center overflow-hidden">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-burgundy/30 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-72 h-72 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-7 text-center lg:text-left space-y-6">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-gold/30 bg-burgundy/20 backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-gold animate-pulse"></span>
            <span class="font-cormorant text-xs sm:text-sm tracking-widest uppercase text-gold font-semibold">ISTANBUL • CHILL, HONEST, SEE WHERE IT GOES</span>
          </div>

          <h1 class="font-cinzel text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-tight">
            HEY, I’M <span class="gold-text-shimmer">BURAKHAN</span>
          </h1>
          <p style="font-size: 50px;"></p>

          <div class="section-divider justify-center lg:justify-start my-4">
            <span class="text-gold text-xl">✦</span>
          </div>

          <p class="font-cormorant text-xl sm:text-2xl text-ivory/90 leading-relaxed italic max-w-2xl">
            Originally from Istanbul, pretty relaxed, and always down for good food and a drink—beer, vodka, or coffee. No rigid plans here; I’m into good energy, mutual attraction, and seeing where things go.
          </p>

          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a href="#apply" class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-burgundy via-burgundy-dark to-burgundy border-2 border-gold hover:border-gold-light text-gold font-cinzel font-bold text-lg tracking-wider rounded-full shadow-gold-glow-lg hover:scale-105 transition-all text-center">See where it goes</a>
            <a href="#legend" class="w-full sm:w-auto px-8 py-4 bg-obsidian-card border border-gold/30 hover:border-gold text-ivory/90 hover:text-gold font-cinzel text-base tracking-wider rounded-full transition-all text-center">More about me</a>
          </div>

          <div class="pt-8 grid grid-cols-3 gap-4 border-t border-gold/20 max-w-lg mx-auto lg:mx-0">
            <div class="text-center lg:text-left">
              <span class="block font-cinzel text-2xl font-bold text-gold">Lublin</span>
              <span class="font-cormorant text-xs sm:text-sm text-ivory/70">Hanging out here</span>
            </div>
            <div class="text-center lg:text-left">
              <span class="block font-cinzel text-2xl font-bold text-gold">Foodie</span>
              <span class="font-cormorant text-xs sm:text-sm text-ivory/70">Always down to eat</span>
            </div>
            <div class="text-center lg:text-left">
              <span class="block font-cinzel text-2xl font-bold text-gold">Easygoing</span>
              <span class="font-cormorant text-xs sm:text-sm text-ivory/70">Zero rush or drama</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md">
            <div id="profile-image-frame" class="relative rounded-3xl bg-white border border-gold/30 overflow-hidden shadow-2xl p-2">
              <div class="relative aspect-[3/4] w-full rounded-2xl overflow-hidden bg-gradient-to-b from-burgundy-dark to-obsidian flex flex-col items-center justify-center text-center p-6">

                <Image id="burakhan-main-img" src={heroPhoto} alt="Burakhan taking a mirror selfie" loading="eager" fetchpriority="high" class="absolute inset-0 w-full h-full object-cover opacity-90 transition-transform duration-700 hover:scale-105" />

                <div id="hero-fallback" class="hidden relative z-10 flex flex-col items-center">
                  <div class="w-24 h-24 rounded-full border-2 border-gold flex items-center justify-center bg-burgundy/60 mb-4">
                    <svg class="w-12 h-12 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                  </div>
                  <span class="font-cinzel text-xl text-gold font-bold">THE BURAKHAN</span>
                  <span class="font-cormorant text-sm text-ivory/70 italic mt-1">Photo unavailable</span>
                </div>

                <div class="profile-overlay absolute inset-x-0 bottom-0 bg-gradient-to-t from-obsidian via-obsidian/70 to-transparent p-6 text-left">
                  <div class="inline-block px-3 py-1 rounded bg-burgundy/80 border border-gold/40 text-gold text-xs font-cinzel font-semibold mb-2">ISTANBUL • 21 | 187cm</div>
                  <h3 class="font-cinzel text-2xl font-bold text-ivory">Burakhan</h3>
                  <p class="font-cormorant text-sm text-gold/90 italic">"Relaxed energy, real chemistry, see where it goes."</p>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="legend" class="py-24 relative border-t border-gold/20 bg-gradient-to-b from-obsidian via-burgundy-dark/30 to-obsidian">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="font-cormorant text-lg text-gold tracking-widest uppercase font-semibold">KEEPING IT SIMPLE</span>
        <h2 class="font-cinzel text-3xl sm:text-5xl font-bold text-ivory">WHERE THINGS GO</h2>
        <div class="section-divider my-2"><span class="text-gold">✦</span></div>
      </div>

      <div class="mt-12 glass-card rounded-2xl p-8 sm:p-12 border border-gold/30 shadow-2xl relative">
        <div class="grid md:grid-cols-2 gap-8 items-center">
          <div class="space-y-6">
            <h3 class="font-cinzel text-2xl text-gold font-bold">Low-key, honest, and open</h3>
            <p class="font-cormorant text-lg text-ivory/90 leading-relaxed">
              I’m <strong class="text-gold font-semibold">Burakhan</strong>. I’m pretty relaxed in how I approach meeting people—grab a drink or a bite, talk easily, and see if there’s a real spark. Whether it stays casual or turns into something more, I’m happy to let it flow naturally.
            </p>
            <p class="font-cormorant text-lg text-ivory/80 leading-relaxed">
              No overthinking or weird games. Just mutual attraction, easy conversation, good vibes, and respecting what feels right for both of us in the moment.
            </p>
          </div>

          <div class="space-y-4 bg-obsidian/70 p-6 rounded-xl border border-gold/20">
            <h4 class="font-cinzel text-lg text-gold border-b border-gold/20 pb-2 flex items-center gap-2"><span>✦</span> How I roll</h4>
            <ul class="space-y-3 font-montserrat text-sm text-ivory/80">
              <li class="flex justify-between border-b border-ivory/10 pb-2">
                <span class="text-ivory/60">Pace:</span>
                <span class="text-gold font-semibold">Relaxed, see where it goes</span>
              </li>
              <li class="flex justify-between border-b border-ivory/10 pb-2">
                <span class="text-ivory/60">First hang:</span>
                <span class="text-gold font-semibold">Drinks or coffee, zero rush</span>
              </li>
              <li class="flex justify-between border-b border-ivory/10 pb-2">
                <span class="text-ivory/60">Always down for:</span>
                <span class="text-gold font-semibold">Good food &amp; new spots</span>
              </li>
              <li class="flex justify-between border-b border-ivory/10 pb-2">
                <span class="text-ivory/60">Energy:</span>
                <span class="text-gold font-semibold">Easygoing &amp; upfront</span>
              </li>
              <li class="flex justify-between">
                <span class="text-ivory/60">Baseline:</span>
                <span class="text-gold font-semibold">Mutual comfort &amp; respect</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="glass-card rounded-xl p-6 text-center space-y-4 hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 rounded-full bg-burgundy/40 border border-gold/40 flex items-center justify-center mx-auto text-3xl">♡</div>
          <h3 class="font-cinzel text-xl text-gold font-bold">Easy chemistry</h3>
          <p class="font-cormorant text-base text-ivory/80">When the conversation flows and the attraction is there, everything feels effortless.</p>
        </div>
        <div class="glass-card rounded-xl p-6 text-center space-y-4 hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 rounded-full bg-burgundy/40 border border-gold/40 flex items-center justify-center mx-auto text-3xl">↗</div>
          <h3 class="font-cinzel text-xl text-gold font-bold">Good food</h3>
          <p class="font-cormorant text-base text-ivory/80">Always up for trying somewhere new or sharing a good meal without taking things too seriously.</p>
        </div>
        <div class="glass-card rounded-xl p-6 text-center space-y-4 hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 rounded-full bg-burgundy/40 border border-gold/40 flex items-center justify-center mx-auto text-3xl">☕</div>
          <h3 class="font-cinzel text-xl text-gold font-bold">Go with the flow</h3>
          <p class="font-cormorant text-base text-ivory/80">No stiff scripts—start with a drink or coffee and see where the night takes us.</p>
        </div>
        <div class="glass-card rounded-xl p-6 text-center space-y-4 hover:-translate-y-2 transition-transform duration-300">
          <div class="w-16 h-16 rounded-full bg-burgundy/40 border border-gold/40 flex items-center justify-center mx-auto text-3xl">✨</div>
          <h3 class="font-cinzel text-xl text-gold font-bold">Mutual comfort</h3>
          <p class="font-cormorant text-base text-ivory/80">Clear boundaries, honest check-ins, and keeping things comfortable for both of us.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- GALLERY -->
  <section id="gallery" class="py-24 relative border-t border-gold/20 bg-obsidian">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="font-cormorant text-lg text-gold tracking-widest uppercase font-semibold">SNAPS FROM RECENT DAYS</span>
        <h2 class="font-cinzel text-3xl sm:text-5xl font-bold text-ivory">LIFE LATELY</h2>
        <div class="section-divider my-2"><span class="text-gold">✦</span></div>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div class="group relative rounded-2xl overflow-hidden glass-card border border-gold/30 aspect-[4/5] shadow-xl">
          <Image src={riversidePhoto} alt="Burakhan by the Danube in Bratislava" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="gallery-caption absolute bottom-0 inset-x-0 p-6 space-y-1">
            <span class="text-xs font-cinzel text-gold uppercase tracking-widest">Slow afternoon</span>
            <h3 class="font-cinzel text-xl text-ivory font-bold">By the river</h3>
            <p class="font-cormorant text-sm text-ivory/70 italic">A calm afternoon in Bratislava.</p>
          </div>
        </div>

        <div class="group relative rounded-2xl overflow-hidden glass-card border border-gold/30 aspect-[4/5] shadow-xl">
          <Image src={nightPhoto} alt="Burakhan by the Danube with Budapest Parliament at night" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="gallery-caption absolute bottom-0 inset-x-0 p-6 space-y-1">
            <span class="text-xs font-cinzel text-gold uppercase tracking-widest">City lights</span>
            <h3 class="font-cinzel text-xl text-ivory font-bold">Budapest at night</h3>
            <p class="font-cormorant text-sm text-ivory/70 italic">An evening by the Danube.</p>
          </div>
        </div>

        <div class="group relative rounded-2xl overflow-hidden glass-card border border-gold/30 aspect-[4/5] shadow-xl">
          <Image src={heroPhoto} alt="Burakhan taking a mirror selfie" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90" />
          <div class="absolute inset-0 bg-gradient-to-t from-obsidian via-transparent to-transparent opacity-80 group-hover:opacity-90 transition-opacity"></div>
          <div class="gallery-caption absolute bottom-0 inset-x-0 p-6 space-y-1">
            <span class="text-xs font-cinzel text-gold uppercase tracking-widest">A quiet moment</span>
            <h3 class="font-cinzel text-xl text-ivory font-bold">Before heading out</h3>
            <p class="font-cormorant text-sm text-ivory/70 italic">A quick mirror selfie.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section id="video" class="py-24 relative border-t border-gold/20 bg-gradient-to-b from-obsidian via-burgundy-dark/20 to-obsidian">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="font-cormorant text-lg text-gold tracking-widest uppercase font-semibold">A MOMENT IN MOTION</span>
        <h2 class="font-cinzel text-3xl sm:text-5xl font-bold text-ivory">LIFE BEYOND THE PHOTOS</h2>
        <div class="section-divider my-2"><span class="text-gold">✦</span></div>
        <p class="font-cormorant text-lg text-ivory/80 italic">A little more life lately, in motion.</p>
      </div>

      <div class="mt-12 glass-card rounded-3xl p-2 sm:p-4 shadow-2xl">
        <video class="block w-full aspect-video rounded-2xl bg-black object-contain" controls playsinline preload="metadata" poster={heroPhoto.src} aria-label="Burakhan profile video">
          <source src={profileVideo} type="video/mp4" />
          Your browser does not support HTML video.
        </video>
      </div>
    </div>
  </section>

  <!-- VIBE -->
  <section id="whispers" class="py-24 relative border-t border-gold/20 bg-gradient-to-b from-obsidian via-burgundy-dark/20 to-obsidian">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="font-cormorant text-lg text-gold tracking-widest uppercase font-semibold">NO PRESSURE, JUST GOOD ENERGY</span>
        <h2 class="font-cinzel text-3xl sm:text-5xl font-bold text-ivory">HOW IT USUALLY GOES</h2>
        <div class="section-divider my-2"><span class="text-gold">✦</span></div>
      </div>

      <div class="mt-12 grid md:grid-cols-3 gap-8">
        <div class="glass-card rounded-2xl p-8 space-y-4">
          <span class="text-xs font-cinzel text-gold uppercase tracking-widest">01 • Start light</span>
          <h3 class="font-cinzel text-xl text-ivory font-bold">Grab a drink or coffee</h3>
          <p class="font-cormorant text-lg text-ivory/80 leading-relaxed">Meet up somewhere relaxed, grab something to eat or drink, and just talk. No big expectations right out of the gate.</p>
        </div>
        <div class="glass-card rounded-2xl p-8 space-y-4">
          <span class="text-xs font-cinzel text-gold uppercase tracking-widest">02 • Feel the vibe</span>
          <h3 class="font-cinzel text-xl text-ivory font-bold">See if we click</h3>
          <p class="font-cormorant text-lg text-ivory/80 leading-relaxed">If the energy feels right and we’re both into it, great—we keep the night going. If not, no awkwardness at all.</p>
        </div>
        <div class="glass-card rounded-2xl p-8 space-y-4">
          <span class="text-xs font-cinzel text-gold uppercase tracking-widest">03 • Stay open</span>
          <h3 class="font-cinzel text-xl text-ivory font-bold">See where things go</h3>
          <p class="font-cormorant text-lg text-ivory/80 leading-relaxed">Keep things easy, honest, and mutual—whether it’s a fun one-off hang or something that builds over time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORM -->
  <section id="apply" class="py-24 relative border-t border-gold/20 bg-obsidian">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-4 mb-12">
        <span class="font-cormorant text-lg text-gold tracking-widest uppercase font-semibold">NO RUSH</span>
        <h2 class="font-cinzel text-3xl sm:text-5xl font-bold text-ivory">SAY HI &amp; SEE WHERE IT GOES</h2>
        <p class="font-cormorant text-lg text-ivory/80 italic">Send a quick note—suggest a drink, a bite to eat, or just say hey.</p>
      </div>

      <form id="connect-form" class="glass-card rounded-2xl p-8 sm:p-10 space-y-6">
        <div class="grid sm:grid-cols-2 gap-6">
          <div>
            <label for="name" class="block font-cinzel text-xs uppercase tracking-widest text-gold mb-2">Your name</label>
            <input id="name" name="name" type="text" required maxlength="100" placeholder="What should I call you?" class="w-full px-4 py-3 rounded-xl bg-obsidian/70 border border-gold/30 text-ivory focus:outline-none focus:border-gold" />
          </div>
          <div>
            <label for="contact" class="block font-cinzel text-xs uppercase tracking-widest text-gold mb-2">Where to reach you</label>
            <input id="contact" name="contact" type="text" required maxlength="200" placeholder="Instagram, handle, or email" class="w-full px-4 py-3 rounded-xl bg-obsidian/70 border border-gold/30 text-ivory focus:outline-none focus:border-gold" />
          </div>
        </div>

        <div>
          <span class="block font-cinzel text-xs uppercase tracking-widest text-gold mb-3">Low-key plan</span>
          <div class="grid sm:grid-cols-3 gap-4">
            <div>
              <input type="radio" name="vibe" id="vibe-drinks" value="Drinks or coffee" class="date-radio sr-only" checked />
              <label for="vibe-drinks" class="block cursor-pointer p-4 rounded-xl border border-gold/25 bg-obsidian/50 text-center transition-all">
                <span class="font-cinzel text-sm text-ivory font-semibold block">Drinks / Coffee</span>
                <span class="font-cormorant text-sm text-ivory/70 italic">Easy first hang</span>
              </label>
            </div>
            <div>
              <input type="radio" name="vibe" id="vibe-food" value="Grab food" class="date-radio sr-only" />
              <label for="vibe-food" class="block cursor-pointer p-4 rounded-xl border border-gold/25 bg-obsidian/50 text-center transition-all">
                <span class="font-cinzel text-sm text-ivory font-semibold block">Grab Food</span>
                <span class="font-cormorant text-sm text-ivory/70 italic">New spot or favorite</span>
              </label>
            </div>
            <div>
              <input type="radio" name="vibe" id="vibe-flow" value="Just see where it goes" class="date-radio sr-only" />
              <label for="vibe-flow" class="block cursor-pointer p-4 rounded-xl border border-gold/25 bg-obsidian/50 text-center transition-all">
                <span class="font-cinzel text-sm text-ivory font-semibold block">See Where It Goes</span>
                <span class="font-cormorant text-sm text-ivory/70 italic">Keep it open</span>
              </label>
            </div>
          </div>
        </div>

        <div>
          <label for="message" class="block font-cinzel text-xs uppercase tracking-widest text-gold mb-2">Quick note</label>
          <textarea id="message" name="message" rows="4" maxlength="2000" placeholder="What’s your vibe, or what sounds good this week?" class="w-full px-4 py-3 rounded-xl bg-obsidian/70 border border-gold/30 text-ivory focus:outline-none focus:border-gold"></textarea>
        </div>

        <button id="submit-btn" type="submit" class="w-full py-4 bg-gradient-to-r from-burgundy via-burgundy-dark to-burgundy border border-gold text-gold font-cinzel font-bold tracking-wider uppercase rounded-full shadow-gold-glow hover:scale-[1.01] transition-all">Send note</button>

        <p id="form-status" class="hidden text-center font-cormorant text-lg text-gold italic pt-2"></p>
      </form>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="py-10 border-t border-gold/20 text-center text-sm text-ivory/60">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="font-cinzel text-gold tracking-widest">BURAKHAN</span>
      <span class="font-cormorant italic">Good energy, honest vibes, and seeing where things go.</span>
    </div>
  </footer>

  <script>
    import { createSupabaseClient } from '../lib/supabase';

    // Menú móvil
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => mobileMenu?.classList.toggle('hidden'));

    // Fallback de la imagen principal
    const mainImg = document.getElementById('burakhan-main-img');
    const heroFallback = document.getElementById('hero-fallback');
    mainImg?.addEventListener('error', () => {
      mainImg.classList.add('hidden');
      heroFallback?.classList.remove('hidden');
    });

    // Cambio de tema
    const toggles = document.querySelectorAll('[data-style-toggle]');
    const syncStyleUI = (theme: string) => {
      const dark = theme === 'after-dark';
      document.body.setAttribute('data-theme', theme);
      toggles.forEach((btn) => {
        btn.setAttribute('aria-pressed', String(dark));
        btn.setAttribute('aria-label', dark ? 'Switch to Modern style' : 'Switch to After Dark style');
        const icon = btn.querySelector('[data-style-icon]');
        const label = btn.querySelector('[data-style-label]');
        if (icon) icon.textContent = dark ? '☀' : '☾';
        if (label) label.textContent = dark ? 'Modern' : 'After Dark';
      });
    };
    syncStyleUI(document.body.getAttribute('data-theme') || 'modern');
    toggles.forEach((btn) =>
      btn.addEventListener('click', () =>
        syncStyleUI(document.body.getAttribute('data-theme') === 'after-dark' ? 'modern' : 'after-dark')
      )
    );

    // Formulario
    const form = document.getElementById('connect-form') as HTMLFormElement | null;
    const statusEl = document.getElementById('form-status');
    const submitButton = document.getElementById('submit-btn') as HTMLButtonElement | null;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const name = String(formData.get('name') ?? '').trim();
      const contact = String(formData.get('contact') ?? '').trim();
      const vibe = String(formData.get('vibe') ?? '');
      const message = String(formData.get('message') ?? '').trim();

      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Sending...';
      }

      try {
        const supabase = createSupabaseClient();
        const { error } = await supabase.from('contact_messages').insert({
          name,
          contact,
          vibe,
          message: message || null,
        });

        if (error) throw error;

        if (statusEl) {
          statusEl.textContent = `Thanks, ${name}—your note has been sent.`;
          statusEl.classList.remove('hidden', 'text-red-400');
          statusEl.classList.add('text-gold');
        }
        form.reset();
      } catch (error) {
        console.error('Could not send the contact form to Supabase:', error);
        if (statusEl) {
          statusEl.textContent =
            error instanceof Error && error.message.startsWith('Missing Supabase environment variables')
              ? 'Supabase is not configured. Add the required variables from .env.example and try again.'
              : 'Your note could not be sent right now. Please try again later.';
          statusEl.classList.remove('hidden', 'text-gold');
          statusEl.classList.add('text-red-400');
        }
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = 'Send note';
        }
      }
    });
  </script>
</body>
</html>